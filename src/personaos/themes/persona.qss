#cardTitle {
    font-size: 14px;
    color: #7fb9ff;
    font-weight: 600;
}

#card {
    background-color: #182848;
    border-radius: 18px;
    border:1px solid rgba(255,255,255,0.06);
    padding: 18px;
}

#cardValue {
    font-size: 30px;
    font-weight: bold;
    color: white;
}

#card:hover {
    border:1px solid #6ec1ff;
}

#cardSubtitle {
    color:rgba(255,255,255,0.55);
    font-size:11px;
}

#infoLabel {

    color: #7db9ff;

    font-size: 14px;
}

#infoValue {

    color: white;

    font-size: 14px;

    font-weight: 600;
}
